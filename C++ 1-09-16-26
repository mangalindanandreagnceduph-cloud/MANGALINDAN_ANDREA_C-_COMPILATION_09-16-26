#include <iostream>  // Fixed: Changed <iosteam> to <iostream>
#include <string>
using namespace std;

int main() {
    //--Declaring variables of different data types-- 
    int age         = 20;     // whole number
    double price    = 19.99;  // decimal number (double precision)
    float weight    = 65.6f;  // decimal number (single precision, using the 'f')
    char grade      = 'A';    // single quotes for single character
    bool isStudent  = true;   // True or False
    string name     = "Maria"; // text

    //---Output using cout -----
    cout << "Name: " << name << endl;         // Output: Name: Maria
    cout << "Age: " << age << endl;           // Output: Age: 20
    cout << "Price: " << price << endl;       // Output: Price: 19.99
    cout << "Weight: " << weight << endl;     // Output: Weight: 65.6 (Note: uses '.' not ',')
    cout << "Grade: " << grade << endl;       // Output: Grade: A
    cout << "Is student?: " << isStudent << endl; // Output: Is student?: 1 (Note: booleans print as 1 or 0)

    return 0;
}

//---- Getting input using cin----

int main()  {
        string userCity;
        cout<<"\nEnter your city: ";
        cin>> userCity; // reads one word(stops at whitespace)
        cout<<"You live in: "<< userCity <<endl;

        //--- Reading a full line(including spaces)----
        cin.ignore(); // clear leftover newline character from previous cin
        string fullSentence;
        cout<<"Enter a sentence about yourself: ";
        getline(cin, fullSentence); // read the entire line
        cout <<"You said:" <<fullSentence <<endl;

        return 0;
}

