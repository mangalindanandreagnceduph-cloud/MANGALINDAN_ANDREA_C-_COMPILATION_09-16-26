int main() {
        // if/ else if/ else----
        int score;
        cout <<"Enter your exam score: ";
        cin >> score;

        if (score >=90){
            cout<<"Grade: A"<< endl;
        } else if (score >= 80){
            cout<<"Grade: B"<< endl;
        } else if (score >= 70){
            cout<<"Grade: C"<< endl;
        } else {
            cout <<"Grade : F" <<endl;
       }

